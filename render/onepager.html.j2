<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{ d.company.name }} — {{ d.company.ticker }}</title>
<style>{{ css }}</style>
</head>
<body>
<div class="sheet">

  <div class="header">
    <p class="eyebrow">{{ d.header.eyebrow }}</p>
    <h1 class="doc-title">{{ d.company.name }}</h1>
    <p class="sub">{{ d.header.tagline }}</p>

    <div class="rule"></div>

    <div class="badge-box">
      <div class="rating">{{ d.call.rating }}</div>
      <div class="rating-sub">{{ d.call.rating_sub }}</div>
    </div>
    {% if d.call.pill %}<span class="pill {{ d.call.pill_class }}">{{ d.call.pill }}</span>{% endif %}
    <span class="header-meta">{{ d.header.source_line }}</span>

    <table class="header-kpis">
      <tr>
        {% for k in d.header.kpis %}
        <td>
          <div class="k">{{ k.label }}</div>
          <div class="v {{ k.tone }}">{{ k.value }}</div>
        </td>
        {% endfor %}
      </tr>
    </table>
  </div>

  <div class="body">

    <p class="eyebrow">La tesis</p>
    <h2 class="section">{{ d.thesis.headline }}</h2>

    {% for block in d.thesis.blocks %}
      <p class="thesis-para">
        <span class="num">{{ "%02d"|format(loop.index) }}</span>{{ block.text }}
      </p>

      {% if block.figure %}
      <div class="figure avoid-break">
        <div class="fig-title">{{ block.figure.title }}</div>
        <div class="fig-body">
          {% if block.figure.svg %}{{ block.figure.svg }}{% endif %}
          {% if block.figure.stats %}
          <table class="stats">
            <tr>
              {% for s in block.figure.stats %}
              <td>
                <div class="big {{ s.tone|default('') }}">{{ s.value }}</div>
                <div class="lbl">{{ s.label }}</div>
                {% if s.sub %}<div class="sublbl">{{ s.sub }}</div>{% endif %}
              </td>
              {% endfor %}
            </tr>
          </table>
          {% endif %}
        </div>
        {% if block.figure.caption %}<p class="caption">{{ block.figure.caption }}</p>{% endif %}
        {% if block.figure.ref %}<p class="ref">{{ block.figure.ref }}</p>{% endif %}
      </div>
      {% endif %}
    {% endfor %}

    <div class="list-head pos">Fortalezas</div>
    <ul class="points">
      {% for p in d.bull %}<li>{{ p }}</li>{% endfor %}
    </ul>

    <div class="list-head neg">A vigilar</div>
    <ul class="points">
      {% for p in d.bear %}<li>{{ p }}</li>{% endfor %}
    </ul>

    <h3 class="block-title" style="margin-top:22px">Snapshot financiero</h3>
    <div style="border-top:1px solid #AB8A69;"></div>
    <table class="kv">
      {% for row in d.snapshot %}
      <tr><td class="k">{{ row.k }}</td><td class="v">{{ row.v }}</td></tr>
      {% endfor %}
    </table>

    {% if d.guidance %}
    <h3 class="block-title" style="margin-top:22px">Guidance del último earnings call</h3>
    <div style="border-top:1px solid #AB8A69;"></div>
    <table class="kv">
      {% for row in d.guidance.rows %}
      <tr><td class="k">{{ row.k }}</td><td class="v">{{ row.v }}</td></tr>
      {% endfor %}
    </table>
    <p class="footnote">{{ d.guidance.source }}</p>
    {% endif %}

    {% if d.peers %}
    <h3 class="block-title" style="margin-top:22px">{{ d.peers.title }}</h3>
    <div style="border-top:1px solid #AB8A69;"></div>
    <p class="lead" style="margin-top:10px">{{ d.peers.intro }}</p>

    <table class="data">
      <thead>
        <tr>
          <th></th>
          {% for c in d.peers.columns %}
          <th>{{ c.name }}<span class="th-sub">{{ c.sub }}</span></th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in d.peers.rows %}
        <tr class="{{ row.cls|default('') }}">
          <td>{{ row.label }}</td>
          {% for v in row["cells"] %}<td>{{ v }}</td>{% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {% for c in d.peers.callouts %}
    <div class="callout">
      <span class="big">{{ c.big }}</span><span class="txt">{{ c.text }}</span>
    </div>
    {% endfor %}
    {% endif %}

    {% if d.valuation_chart %}
    <div class="figure avoid-break" style="margin-top:18px">
      <div class="fig-title">{{ d.valuation_chart.title }}</div>
      <div class="fig-body">{{ d.valuation_chart.svg }}</div>
      {% if d.valuation_chart.caption %}<p class="caption">{{ d.valuation_chart.caption }}</p>{% endif %}
      {% if d.valuation_chart.ref %}<p class="ref">{{ d.valuation_chart.ref }}</p>{% endif %}
    </div>
    {% endif %}

    <div class="disclaimer">{{ d.disclaimer }}</div>

    <div class="signoff">
      <div class="name">{{ d.signoff.name }}</div>
      <div class="muted">{{ d.signoff.line }}</div>
    </div>

  </div>
</div>
</body>
</html>
